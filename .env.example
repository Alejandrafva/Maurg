# --- IA (obligatorio) ---
# Clave de https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo (low = más rápido y barato)
# Para gastar lo mínimo usa claude-haiku-5-5 (por defecto: claude-opus-5-5)
# AI_MODEL=claude-haiku-5-5
# AI_EFFORT=low

# --- Servidor ---
PORT=3000
# URL pública del servidor (https). Necesaria para el webhook y para enviar fotos por Facebook/Instagram.
PUBLIC_URL=https://tu-dominio.com
# Contraseña del panel (usuario: admin). Muy recomendado en producción.
ADMIN_PASSWORD=
# Email que aparece en la política de privacidad (/privacidad)
CONTACT_EMAIL=

# --- Meta (WhatsApp, Facebook, Instagram) ---
# Un texto que tú inventas; el mismo va en la configuración del webhook en Meta.
META_VERIFY_TOKEN=pon-aqui-un-texto-secreto
# "Clave secreta de la app" (Configuración > Básica). Verifica que los mensajes vienen de Meta.
META_APP_SECRET=
# GRAPH_API_VERSION=v23.0

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Facebook Messenger (token de acceso de la página). Sirve también para Instagram si la cuenta
# de Instagram está vinculada a la página.
FACEBOOK_PAGE_TOKEN=

# Instagram con "Instagram Login" (opcional; si lo pones se usa en vez del token de página)
INSTAGRAM_ACCESS_TOKEN=

# --- Supabase (obligatorio en Render gratis: guarda productos, conversaciones y fotos) ---
# Supabase → Project Settings → API: "Project URL" y la clave "service_role" (secreta, nunca en el navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Almacén / inventario externo (opcional) ---
# Cabecera Authorization si tu sistema de inventario la pide, p. ej. "Bearer abc123"
INVENTORY_SOURCE_AUTH=
